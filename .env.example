# Required: powers the /api/identify endpoint (image/name/description -> normalized query).
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: enables live price search via SerpApi's Google Shopping engine.
# Without this, the app runs in demo mode with deterministic mock offers.
# Get a key from https://serpapi.com/
SERPAPI_KEY=

# Optional: alternative live price source using Gemini on Vertex AI with Google
# Search grounding, used when SERPAPI_KEY is not set. Paste the full downloaded
# service-account JSON as a single-line string value. Requires the Vertex AI API
# enabled and a service account with the "Vertex AI User" role on that project.
# Caveat: prices are AI-summarized from search results, not a structured feed like
# SerpApi — treat as lower-confidence (can repeat prices across stores, and offer
# URLs are Google grounding-redirect links rather than direct retailer links).
GOOGLE_VERTEX_CREDENTIALS_JSON=
GOOGLE_VERTEX_LOCATION=us-central1
GOOGLE_VERTEX_MODEL=gemini-2.5-flash

# Optional: Upstash Redis (https://upstash.com/) for shared, durable caching of
# search results across serverless invocations. Without these, the app falls
# back to an in-memory LRU cache (per server instance, cleared on restart/cold-start).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: display name used in the UI header/title.
NEXT_PUBLIC_APP_NAME=PriceScout
