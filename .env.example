# Required: powers the /api/identify endpoint (image/name/description -> normalized query).
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: enables live price search via SerpApi's Google Shopping engine.
# Without this, the app runs in demo mode with deterministic mock offers.
# Get a key from https://serpapi.com/
SERPAPI_KEY=

# Optional: 2nd-choice live price source, used when SERPAPI_KEY is not set — no
# paid signup required. Uses Gemini's Google Search grounding tool (not a dedicated
# shopping API) to find current prices, and every resulting offer link is filtered
# through the trusted-vendor allow-list (lib/trustedVendors.ts) before it's shown.
# Configure ONE of the two auth methods below (if both are set, the service-account
# JSON takes priority):
#
# Option A — Vertex AI service account (paste the full downloaded JSON as a
# single-line string; requires the Vertex AI API enabled on that GCP project).
GOOGLE_VERTEX_CREDENTIALS_JSON=
GOOGLE_VERTEX_LOCATION=us-central1
#
# Option B — plain Gemini Developer API key, free from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Upstash Redis (https://upstash.com/) for shared, durable caching of
# search results across serverless invocations. Without these, the app falls
# back to an in-memory LRU cache (per server instance, cleared on restart/cold-start).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: display name used in the UI header/title.
NEXT_PUBLIC_APP_NAME=PriceScout
