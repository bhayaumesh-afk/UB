# Required: powers the /api/identify endpoint (image/name/description -> normalized query).
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: enables live price search via SerpApi's Google Shopping engine.
# Without this, the app runs in demo mode with deterministic mock offers.
# Get a key from https://serpapi.com/
SERPAPI_KEY=

# Optional: Upstash Redis (https://upstash.com/) for shared, durable caching of
# search results across serverless invocations. Without these, the app falls
# back to an in-memory LRU cache (per server instance, cleared on restart/cold-start).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: display name used in the UI header/title.
NEXT_PUBLIC_APP_NAME=PriceScout
