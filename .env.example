# Required: powers the /api/identify endpoint (image/name/description -> normalized query).
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: enables live price search via SerpApi's Google Shopping engine.
# Without this, the app runs in demo mode with deterministic mock offers.
# Get a key from https://serpapi.com/
SERPAPI_KEY=

# Optional: 2nd-choice live price source, used when SERPAPI_KEY is not set — no
# paid SerpApi signup required. Uses Gemini on Vertex AI with Google Search grounding
# (not a dedicated shopping API) to find current prices. Every grounded citation is
# resolved to its real final URL and checked against the trusted-vendor allow-list
# (lib/trustedVendors.ts) before it's ever shown — offers on unrecognized domains are
# dropped entirely.
#
# Requires a Vertex AI service account:
#   1. In the GCP project, enable the Vertex AI API.
#   2. Create a service account with ONLY the `roles/aiplatform.user` role — least
#      privilege; it doesn't need anything broader than calling generateContent.
#   3. Create and download a JSON key for it.
#   4. Minify it to one line before pasting below, so the private_key field's
#      embedded newlines don't break env var storage:
#        jq -c . path/to/downloaded-key.json
GCP_SERVICE_ACCOUNT_JSON=
# Region to call — reuse whatever region already worked for this project; an
# unproven region can silently 404 or route to a model that isn't enabled there.
GCP_VERTEX_LOCATION=us-central1
#
# Cost note: Vertex AI Search grounding is billed per grounded request (not free
# like the base model call). The app's existing ~15-minute result cache
# (lib/cache.ts) means repeated searches for the same product within that window
# don't trigger new grounded requests, which caps this from becoming a silent
# cost surprise, but distinct product searches still each cost one grounded call.

# Optional: Upstash Redis (https://upstash.com/) for shared, durable caching of
# search results across serverless invocations. Without these, the app falls
# back to an in-memory LRU cache (per server instance, cleared on restart/cold-start).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: display name used in the UI header/title.
NEXT_PUBLIC_APP_NAME=PriceScout
